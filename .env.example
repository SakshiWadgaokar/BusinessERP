# ==============================================================================
# BUSINESS ERP — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in secure environment-specific values.
# NEVER commit .env or hardcode secrets in source code.
# ==============================================================================

NODE_ENV=development
APP_NAME="Business ERP"

# API Server
API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# PostgreSQL 17 Database
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/business_erp?schema=public"

# Authentication & Security (Generate 64-byte random hex secrets in production)
JWT_ACCESS_SECRET="CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
CSRF_SECRET="CHANGE_ME_MIN_32_CHARS_CSRF_SECRET"
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Document Storage (Private S3-Compatible Object Storage)
# STORAGE_DRIVER: "s3" (Production/Staging) | "local_private" (Local Dev fallback without Docker)
STORAGE_DRIVER=local_private
STORAGE_LOCAL_DIR="./.local-storage"
STORAGE_SIGNED_URL_SECRET="CHANGE_ME_MIN_32_CHARS_STORAGE_SIGNING_SECRET"
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="erp-private-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# Initial Super Admin Seed (used only by prisma/seed.ts when no super admin exists)
SEED_SUPER_ADMIN_NAME="System Owner"
SEED_SUPER_ADMIN_EMAIL="owner@businesserp.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@2026!"

# Backup Configuration
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30
PG_BIN_DIR="C:\\Program Files\\PostgreSQL\\17\\bin"
